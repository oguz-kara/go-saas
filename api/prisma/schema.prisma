generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum CompanyNoteType {
  GENERAL
  MEETING
  CALL
  FOLLOW_UP
}

// Enums
enum AttributeTypeKind {
  TEXT
  SELECT
  MULTI_SELECT
  HIERARCHICAL
}

enum AttributeDataType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  CURRENCY
  USER
}

enum AttributableType {
  COMPANY
}

model AttributeGroup {
  id              String  @id @default(cuid())
  name            String
  code            String
  order           Int?
  isSystemDefined Boolean @default(false)

  channelToken String
  channel      Channel @relation(fields: [channelToken], references: [token])

  // Bu gruba ait özellik tipleri
  attributeTypes AttributeType[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([name, channelToken])
  @@unique([code, channelToken])
}

// Models
model AttributeType {
  // Primary Key
  id String @id @default(cuid())

  // Basic Fields
  name            String
  code            String
  kind            AttributeTypeKind
  dataType        AttributeDataType
  isSystemDefined Boolean           @default(false)
  order           Int               @default(0)

  /**
   * Bu config alanı içinde { "isRequired": true, "minValue": 1, "maxValue": 1000, "defaultValue": 10 } gibi kurallar saklayabiliriz.
   */
  config Json? // Özelliğe özel kuralları burada saklarızdataType ornegin calisan sayisi max 1000, bu config'den alabiliriz.

  // Relations
  channelToken String
  channel      Channel          @relation(fields: [channelToken], references: [token])
  values       AttributeValue[]

  groupId String?
  group   AttributeGroup? @relation(fields: [groupId], references: [id])

  availableFor AttributeTypeToEntityType[]

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Constraints
  @@unique([name, channelToken])
  @@unique([code, channelToken])
}

model AttributeValue {
  // Primary Key
  id String @id @default(cuid())

  // Basic Fields
  value String
  code  String
  order Int    @default(0)
  meta  Json?

  // Relations
  attributeTypeId String
  type            AttributeType @relation(fields: [attributeTypeId], references: [id], onDelete: Cascade)

  channelToken String
  channel      Channel @relation(fields: [channelToken], references: [token])

  assignments AttributeAssignment[]

  // Hierarchical Relations
  parentId String? // Parent value ID (e.g., Turkey's ID for Izmir)
  parent   AttributeValue?  @relation("AttributeHierarchy", fields: [parentId], references: [id], onDelete: NoAction)
  children AttributeValue[] @relation("AttributeHierarchy")

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([attributeTypeId])
}

model AttributeTypeToEntityType {
  attributeTypeId String
  attributeType   AttributeType @relation(fields: [attributeTypeId], references: [id], onDelete: Cascade)

  entityType AttributableType

  @@id([attributeTypeId, entityType])
}

// Hangi AttributeValue'nun, hangi spesifik kayda atandığını tutan polimorfik tablo.
model AttributeAssignment {
  id String @id @default(cuid())

  attributeValueId String
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  attributableId   String // İlişkilendirilen kaydın ID'si (Company ID, Product ID, vs.)
  attributableType AttributableType // İlişkilendirilen kaydın TİPİ

  channelToken String
  channel      Channel @relation(fields: [channelToken], references: [token])

  assignedById String?
  assignedBy   User?    @relation(fields: [assignedById], references: [id], onDelete: SetNull)
  assignedAt   DateTime @default(now())

  companyId String? // Company'e olan direkt ilişki (Prisma'nın many-to-many için gerektirdiği)
  company   Company? @relation(fields: [companyId], references: [id])

  @@unique([attributeValueId, attributableId, attributableType])
  @@index([attributableId, attributableType])
}

model User {
  // Primary Key
  id String @id @default(cuid())

  // Basic Fields
  email    String  @unique
  name     String?
  password String

  // Relations
  channelToken String
  channel      Channel @relation(fields: [channelToken], references: [token])

  // Attribute System Relations
  attributeAssignments AttributeAssignment[]

  // Note Relations
  companyNotes CompanyNote[]

  // API Keys created by this user
  apiKeys ApiKey[]

  // Timestamps
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  leads         Lead[]
  activities    Activity[]
  notes         Note[]
  notifications Notification[]
}

model Channel {
  // Primary Key
  id String @id @default(cuid())

  // Basic Fields
  name        String  @unique
  token       String  @unique
  description String?

  // Email Configuration
  marketingEmails String[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations - Core
  companies    Company[]
  users        User[]
  companyNotes CompanyNote[]

  // Relations - Attribute System
  attributeTypes       AttributeType[]
  attributeValues      AttributeValue[]
  attributeGroups      AttributeGroup[]
  attributeAssignments AttributeAssignment[]

  // API Keys
  apiKeys ApiKey[]
}

// Models
model Company {
  // Primary Key
  id String @id @default(cuid())

  // Basic Fields
  name        String
  website     String?
  taxId       String?
  description String?

  // --- Contact & Location ---

  address        Json?
  phoneNumber    String?
  email          String?
  linkedinUrl    String?
  socialProfiles Json?

  // Relations
  channelToken String?
  channel      Channel? @relation(fields: [channelToken], references: [token], onDelete: Restrict)

  // Attribute System Relations
  attributeAssignments AttributeAssignment[]

  // Note Relations
  notes CompanyNote[]

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model CompanyNote {
  // Primary Key
  id String @id @default(cuid())

  // Basic Fields
  content String
  type    CompanyNoteType?

  // Relations
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  channelToken String
  channel      Channel @relation(fields: [channelToken], references: [token])

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes
  @@index([companyId])
  @@index([userId])
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  NEGOTIATION
  CONVERTED
  LOST
  UNQUALIFIED
}

enum LeadSource {
  WEBSITE
  REFERRAL
  SOCIAL_MEDIA
  EMAIL_CAMPAIGN
  PAID_ADS
  COLD_OUTREACH
  EVENT
  PARTNER
  ADMIN
  OTHER
  GOOGLE_ADS
  FACEBOOK_ADS
  LINKEDIN_ADS
  ORGANIC_SEARCH
  DIRECT_TRAFFIC
}

enum ProductInterest {
  SAAS
  MOBILE_APP
  WEB_APP
  CUSTOM_SOFTWARE
  API_INTEGRATION
  CONSULTING
  OTHER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Lead {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Contact Information
  firstName String
  lastName  String
  email     String  @unique
  phone     String?
  company   String?
  jobTitle  String?
  website   String?

  // Lead Details
  status   LeadStatus @default(NEW)
  source   LeadSource
  priority Priority   @default(MEDIUM)

  // Product Interest
  productInterest ProductInterest[]
  budget          Decimal?          @db.Decimal(12, 2)
  timeline        String? // e.g., "Q1 2025", "3-6 months"

  // Qualification
  companySize     Int?
  isDecisionMaker Boolean @default(false)
  painPoints      String? @db.Text
  currentSolution String?

  // Tracking
  lastContactedAt DateTime?
  convertedAt     DateTime?
  lostReason      String?

  // Relationships
  assignedToId  String?
  assignedTo    User?          @relation(fields: [assignedToId], references: [id])
  activities    Activity[]
  notes         Note[]
  tags          Tag[]
  notifications Notification[]

  @@index([status])
  @@index([assignedToId])
  @@index([createdAt])
  @@index([email])
}

model Activity {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  type        String // call, email, meeting, demo, follow_up
  subject     String
  description String?   @db.Text
  scheduledAt DateTime?
  completedAt DateTime?

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([leadId])
  @@index([userId])
  @@index([scheduledAt])
}

model Note {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  content String @db.Text

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([leadId])
}

model Tag {
  id    String  @id @default(cuid())
  name  String  @unique
  color String? // hex color for UI

  leads Lead[]

  @@index([name])
}

enum NotificationType {
  NEW_LEAD
  LEAD_STATUS_CHANGED
  ACTIVITY_DUE
  LEAD_ASSIGNED
  // room for future notification types
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
}

model Notification {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  type     NotificationType
  priority NotificationPriority @default(MEDIUM)
  title    String
  message  String               @db.Text

  // Notification state
  isRead Boolean   @default(false)
  readAt DateTime?

  // Reference to the lead (optional, for lead-related notifications)
  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  // Who should see this notification
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Optional: metadata as JSON for flexibility
  metadata Json? // can store additional data like { source: "WEBSITE", email: "..." }

  @@index([userId, isRead])
  @@index([createdAt])
  @@index([leadId])
}

model ApiKey {
  id       String  @id @default(cuid())
  name     String // Descriptive name (e.g., "Marketing Website - Production")
  keyHash  String  @unique // Hashed version of the API key
  prefix   String // First 8 characters for display (e.g., "mk_live_")
  isActive Boolean @default(true)

  // Expiration & Usage Tracking
  expiresAt   DateTime?
  usageCount  Int      @default(0)
  lastUsedAt  DateTime?
  lastUsedIp  String?

  // Metadata for tracking and configuration
  metadata Json? // Can store allowed sources, rate limits, etc.

  // Relations
  channelToken String
  channel      Channel @relation(fields: [channelToken], references: [token])

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes for performance
  @@index([keyHash])
  @@index([channelToken])
  @@index([isActive])
}
