{{> header subject="Yeni Potansiyel Müşteri - {{lead.firstName}} {{lead.lastName}}"}}

<!-- Alert Header -->
<div style="background: linear-gradient(135deg, #007bff 0%, #0056b3 100%); border-radius: 10px; padding: 24px; margin-bottom: 28px; text-align: center;">
  <div style="font-size: 42px; margin-bottom: 8px;">🚀</div>
  <h1 style="color: #ffffff; margin: 0 0 8px 0; font-size: 26px; font-weight: 700;">
    Yeni Potansiyel Müşteri!
  </h1>
  <p style="color: #e0f2fe; margin: 0; font-size: 15px;">
    <strong>{{lead.source}}</strong> kanalından yeni bir müşteri adayı aldınız
  </p>
</div>

<!-- Lead Name Card -->
<div style="background: linear-gradient(to right, #1a1a1a 0%, #333333 100%); border-radius: 10px; padding: 20px 24px; margin-bottom: 24px; border-left: 4px solid #007bff;">
  <h2 style="color: #ffffff; margin: 0 0 4px 0; font-size: 22px; font-weight: 700;">
    {{lead.firstName}} {{lead.lastName}}
  </h2>
  <p style="color: #b3b3b3; margin: 0; font-size: 15px;">
    <a href="mailto:{{lead.email}}" style="color: #60a5fa; text-decoration: none;">{{lead.email}}</a>
  </p>
</div>

<!-- Quick Contact Info -->
<div style="background-color: #ffffff; border: 1px solid #e5e5e5; border-radius: 10px; padding: 24px; margin-bottom: 24px;">
  <h3 style="color: #1a1a1a; font-size: 17px; font-weight: 600; margin: 0 0 16px 0; padding-bottom: 12px; border-bottom: 2px solid #e0e0e0;">
    📞 İletişim Bilgileri
  </h3>
  
  <table style="width: 100%; border-collapse: collapse;">
    <tr>
      <td style="padding: 10px 0; font-weight: 600; width: 35%; color: #666666; font-size: 14px; vertical-align: top;">
        Ad Soyad:
      </td>
      <td style="padding: 10px 0; color: #1a1a1a; font-size: 14px; font-weight: 500;">
        {{lead.firstName}} {{lead.lastName}}
      </td>
    </tr>
    <tr>
      <td style="padding: 10px 0; font-weight: 600; width: 35%; color: #666666; font-size: 14px; vertical-align: top;">
        E-posta:
      </td>
      <td style="padding: 10px 0; color: #1a1a1a; font-size: 14px;">
        <a href="mailto:{{lead.email}}" style="color: #007bff; text-decoration: none; font-weight: 500;">{{lead.email}}</a>
      </td>
    </tr>
    {{#if lead.phone}}
    <tr>
      <td style="padding: 10px 0; font-weight: 600; width: 35%; color: #666666; font-size: 14px; vertical-align: top;">
        Telefon:
      </td>
      <td style="padding: 10px 0; color: #1a1a1a; font-size: 14px;">
        <a href="tel:{{lead.phone}}" style="color: #007bff; text-decoration: none; font-weight: 500;">{{lead.phone}}</a>
      </td>
    </tr>
    {{/if}}
    <tr>
      <td style="padding: 10px 0; font-weight: 600; width: 35%; color: #666666; font-size: 14px; vertical-align: top;">
        Kaynak:
      </td>
      <td style="padding: 10px 0; color: #1a1a1a; font-size: 14px;">
        <span style="display: inline-block; background-color: #e0f2fe; color: #0369a1; padding: 6px 12px; border-radius: 6px; font-size: 13px; font-weight: 600;">
          {{lead.source}}
        </span>
      </td>
    </tr>
    <tr>
      <td style="padding: 10px 0; font-weight: 600; width: 35%; color: #666666; font-size: 14px; vertical-align: top;">
        Öncelik:
      </td>
      <td style="padding: 10px 0; color: #1a1a1a; font-size: 14px;">
        {{#eq lead.priority "URGENT"}}
          <span style="display: inline-block; background-color: #fee2e2; color: #991b1b; padding: 6px 12px; border-radius: 6px; font-size: 13px; font-weight: 700; border: 1px solid #fca5a5;">
            🔴 ACİL
          </span>
        {{else}}
          {{#eq lead.priority "HIGH"}}
            <span style="display: inline-block; background-color: #fed7aa; color: #c2410c; padding: 6px 12px; border-radius: 6px; font-size: 13px; font-weight: 600; border: 1px solid #fdba74;">
              🟠 YÜKSEK
            </span>
          {{else}}
            {{#eq lead.priority "MEDIUM"}}
              <span style="display: inline-block; background-color: #bfdbfe; color: #1e40af; padding: 6px 12px; border-radius: 6px; font-size: 13px; font-weight: 600; border: 1px solid #93c5fd;">
                🔵 ORTA
              </span>
            {{else}}
              <span style="display: inline-block; background-color: #e5e7eb; color: #374151; padding: 6px 12px; border-radius: 6px; font-size: 13px; font-weight: 500; border: 1px solid #d1d5db;">
                ⚪ DÜŞÜK
              </span>
            {{/eq}}
          {{/eq}}
        {{/eq}}
      </td>
    </tr>
  </table>
</div>

<!-- Lead Details -->
{{> lead-details}}

<!-- Assignment Info -->
{{#if assignedTo}}
<div style="background: linear-gradient(to right, #dbeafe 0%, #bfdbfe 100%); border: 1px solid #93c5fd; border-radius: 10px; padding: 20px 24px; margin-top: 24px;">
  <p style="margin: 0; color: #1e40af; font-size: 15px;">
    <strong style="font-weight: 700; font-size: 16px;">👤 Atanan Kişi:</strong><br>
    <span style="font-size: 15px; margin-top: 4px; display: inline-block;">
      {{assignedTo.name}} 
      <span style="color: #3b82f6;">(<a href="mailto:{{assignedTo.email}}" style="color: #1e40af; text-decoration: none;">{{assignedTo.email}}</a>)</span>
    </span>
  </p>
</div>
{{/if}}

<!-- Action Required Alert -->
<div style="background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%); border-left: 4px solid #f59e0b; border-radius: 10px; padding: 20px 24px; margin-top: 24px;">
  <div style="display: table; width: 100%;">
    <div style="display: table-cell; vertical-align: middle; width: 48px;">
      <div style="font-size: 32px;">⏰</div>
    </div>
    <div style="display: table-cell; vertical-align: middle; padding-left: 16px;">
      <p style="margin: 0 0 4px 0; color: #92400e; font-size: 16px; font-weight: 700;">
        Aksiyon Gerekli
      </p>
      <p style="margin: 0; color: #78350f; font-size: 14px; line-height: 1.6;">
        Lütfen bu potansiyel müşteriyi inceleyin ve <strong>24 saat içinde</strong> geri dönüş yapın.
      </p>
    </div>
  </div>
</div>

<!-- CTA Button -->
<div style="text-align: center; margin-top: 32px;">
  <table cellpadding="0" cellspacing="0" border="0" style="margin: 0 auto;">
    <tr>
      <td style="background: linear-gradient(135deg, #007bff 0%, #0056b3 100%); border-radius: 10px; padding: 14px 32px; text-align: center;">
        <a href="#" style="color: #ffffff; text-decoration: none; font-weight: 600; font-size: 15px; display: inline-block;">
          CRM'de Görüntüle →
        </a>
      </td>
    </tr>
  </table>
</div>

{{> footer}}
